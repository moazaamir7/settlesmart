# Use a long URL-safe random value. Do not commit the real file.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# The final HTTPS origin, with no trailing slash.
PUBLIC_ORIGIN=https://expenses.example.com

# Comma-separated hostnames accepted by the API.
ALLOWED_HOSTS=expenses.example.com

# Host port used when running Docker Compose directly.
APP_PORT=8080
